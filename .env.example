# Service identification
SERVICE_NAME=agent_api
LOG_LEVEL=INFO

# LLM provider selection
LLM_PROVIDER=ollama              # ollama (по умолчанию, без ключей) | openrouter
LLM_MODEL_NAME=qwen3:8b
LLM_API_KEY=                     # required for openrouter
LLM_MODE=tools                   # tools (по умолчанию, реальная LLM) | json | fallback

# --- Альтернатива: OpenRouter (облако, нужен ключ) ---
# LLM_PROVIDER=openrouter
# LLM_MODEL_NAME=qwen/qwen3-8b
# LLM_API_KEY=sk-or-v1-...
LLM_MAX_ITERATIONS=6
LLM_TIMEOUT_SECONDS=30

# Ollama endpoint
OLLAMA_HOST=http://host.docker.internal:11434
# Qwen3/r1 thinking mode: 0=off (fast), 1=on (slower, deeper reasoning), empty=provider default
OLLAMA_THINK=0

# RAG
# По умолчанию агент использует rag_mock (структурированный план required_actions).
# Чтобы переключиться на реальный RAG через адаптер:
#   RAG_BASE_URL=http://rag_adapter:8091
# rag_adapter вызывает реальный RAG (REAL_RAG_URL) и возвращает отфильтрованный
# текстовый ответ в answer_text. Пока REAL_RAG_URL не задан — адаптер мягко
# деградирует в пустой ответ, агент работает по precheck + fallback-плану.
RAG_BASE_URL=http://rag_mock:8090

# --- Реальный RAG (используется только сервисом rag_adapter) ---
# TODO(stand): получить URL реального RAG у команды тестового стенда.
REAL_RAG_URL=
REAL_RAG_COLLECTION=СУЛЗ
REAL_RAG_USE_CACHE=true
REAL_RAG_PROMPT_TYPE=system
REAL_RAG_TIMEOUT_SECONDS=30

# MCP server
MCP_SERVER_MODULE=services.mcp_server.mcp_server

# Agent runtime
REQUEST_TIME_BUDGET_SECONDS=90
ALLOW_QUEUE_CHANGE=false

# Debug
DEBUG=false
MCP_DEBUG=false

# --- Новое: безопасность LLM-фазы и recheck ---
LLM_MAX_STEPS=12
LLM_MAX_TOOL_ERRORS=3
VERIFY_RECHECK_WINDOW_DAYS=1
MRF_MOCK_SEED=0
